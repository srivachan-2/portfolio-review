# =========================================================
# PortfolioAI WRITER - Server-Side Environment Variables
# =========================================================
#
# IMPORTANT SECURITY NOTICE:
# GEMINI_API_KEY is a server-side secret for the serverless API proxy (/api/ai).
# It must NEVER be exposed to the browser or prefixed with VITE_.
# NEVER commit your real API key to Git.
#
# Server-side Google Gemini API Key:
GEMINI_API_KEY=your_server_side_key_here

# Configurable Gemini Model (Default: gemini-3.6-flash):
GEMINI_MODEL=gemini-3.6-flash
