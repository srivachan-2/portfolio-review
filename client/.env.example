# =========================================================
# PortfolioAI WRITER - Client Development Environment Variables
# =========================================================
#
# IMPORTANT:
# GEMINI_API_KEY is read by the local Vite dev middleware and Vercel serverless function.
# It must NEVER be prefixed with VITE_ or exposed to client-side bundles.
#
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
